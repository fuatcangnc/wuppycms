{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "builder",
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wuppycms",
			"database_id": "bfafe20b-eed9-4853-a5e5-c6ca15c0c15c",
			"migrations_dir": "db/migrations"
		}
	],
	"vars": {
		"SITE_TEMPLATE_REPO": "fuatcangnc/wuppycms-tailwind-starter"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_R2",
			"bucket_name": "wuppycms-media"
		}
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	}
}
