---
// Karşılama ekranı (marketing) — TuranCMS'teki /marketing karşılığı.
// Oturum varsa doğrudan projelere gider.
import { Button } from "@/components/ui/button";
import "../styles/global.css";
import { t } from "@/lib/i18n";
import { getSession } from "@/lib/session";

const session = await getSession(Astro);
if (session) return Astro.redirect("/projects");

const steps = [
	{ title: t("landing.step1Title"), text: t("landing.step1Text") },
	{ title: t("landing.step2Title"), text: t("landing.step2Text") },
	{ title: t("landing.step3Title"), text: t("landing.step3Text") },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{t("landing.title")}</title>
		<meta
			name="description"
			content={t("landing.description")}
		/>
	</head>
	<body class="bg-background text-foreground antialiased">
		<div class="flex min-h-screen flex-col">
			<header class="flex h-14 shrink-0 items-center justify-between border-b border-border px-4 md:px-8">
				<span class="flex items-center gap-2 text-sm font-semibold">
					<span class="inline-block size-5 rounded-md bg-primary"></span>
					WuppyCMS
				</span>
				<nav class="flex items-center gap-2">
					<Button as="a" href="/login" size="sm" variant="ghost">{t("auth.signIn")}</Button>
					<Button as="a" href="/signup" size="sm">{t("landing.getStart")}</Button>
				</nav>
			</header>

			<main class="mx-auto flex w-full max-w-4xl flex-1 flex-col items-center gap-8 px-6 py-16 text-center md:py-24">
				<span class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
					{t("landing.tagline")}
				</span>
				<h1 class="max-w-2xl text-4xl font-bold tracking-tight md:text-5xl">
					{t("landing.heroLine1")}<br />{t("landing.heroLine2")}
				</h1>
				<p class="max-w-xl text-muted-foreground">
					{t("landing.heroBody")}
				</p>
				<div class="flex gap-3">
					<Button as="a" href="/signup" size="lg">{t("landing.getStart")}</Button>
					<Button as="a" href="/login" size="lg" variant="outline">{t("auth.signIn")}</Button>
				</div>

				<div class="mt-10 grid w-full gap-4 text-left md:grid-cols-3">
					{
						steps.map((step, index) => (
							<div class="rounded-xl border border-border bg-card p-5">
								<span class="text-xs font-semibold uppercase tracking-wide text-primary">
									{t("landing.stepN", { number: index + 1 })}
								</span>
								<h2 class="mt-2 font-semibold">{step.title}</h2>
								<p class="mt-1 text-sm text-muted-foreground">{step.text}</p>
							</div>
						))
					}
				</div>
			</main>

			<footer class="border-t border-border px-6 py-6 text-center text-xs text-muted-foreground">
				{t("landing.footer")}
			</footer>
		</div>
	</body>
</html>
