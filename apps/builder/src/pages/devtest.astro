---
export const prerender = false;
---
<html lang="tr">
	<head><meta charset="utf-8" /><title>Nodepod test</title></head>
	<body style="font-family:system-ui;padding:20px">
		<h1>Nodepod + Astro testi</h1>
		<pre id="log" style="background:#111;color:#0f0;padding:12px;min-height:320px;white-space:pre-wrap"></pre>
		<script is:inline>
			const el = document.getElementById("log");
			const log = (m) => { el.textContent += m + "\n"; };
			const clean = (t) => String(t).replace(/\x1b\[[0-9;]*m/g, "").slice(0, 260);
			window.__state = "running";
			(async () => {
				try {
					const mod = await import("/nodepod/index.js");
					mod.setRuntimeHost(mod.createBrowserHost());
					const pod = await mod.Nodepod.boot({
						serviceWorker: false,
						workdir: "/home/project",
						files: {
							"/home/project/package.json": JSON.stringify({
								name: "spike", private: true, type: "module",
								dependencies: { astro: "^7.2.4" },
							}),
							"/home/project/src/pages/index.astro":
								`---\nconst msg = "Astro in Nodepod"\n---\n<html><body><h1>{msg}</h1></body></html>`,
							"/home/project/start.mjs":
								`process.env.NAPI_RS_FORCE_WASI = "true";\nprocess.argv = ["node", "astro", "dev", "--host", "0.0.0.0", "--port", "4321"];\nawait import("./node_modules/astro/bin/astro.mjs");\n`,
							"/home/project/ver.mjs":
								`process.env.NAPI_RS_FORCE_WASI = "true";\nprocess.argv = ["node", "astro", "--version"];\nawait import("./node_modules/astro/bin/astro.mjs");\n`,
						},
					});
					log("booted");
					const install = await pod.spawn("npm", ["install", "--no-audit", "--no-fund"]);
					install.on("output", (t) => log("I:" + clean(t)));
					await install.completion.catch((e) => log("install err " + (e && e.message)));
					log("install done");

					const run = async (label, args, waitMs) => {
						const p = await pod.spawn("node", args);
						let out = "";
						p.on("output", (t) => { out += clean(t); });
						const res = await Promise.race([
							p.completion.then((c) => c).catch((e) => ({ error: e.message })),
							new Promise((r) => setTimeout(() => r("running"), waitMs)),
						]);
						log(`${label}: ${JSON.stringify(res)} OUT=${out.slice(0, 400)}`);
						return p;
					};
					await run("binding", ["-e", "process.env.NAPI_RS_FORCE_WASI='true'; import('@rolldown/binding-wasm32-wasi').then(m=>console.log('BINDING_OK',Object.keys(m).join(','))).catch(e=>console.error('BINDING_ERR',e&&e.stack))"], 25000);
					await run("rolldown", ["-e", "process.env.NAPI_RS_FORCE_WASI='true'; import('rolldown').then(m=>console.log('ROLLDOWN_OK',Object.keys(m).length)).catch(e=>console.error('ROLLDOWN_ERR',e&&e.stack))"], 30000);
					const dev = await run("dev", ["start.mjs"], 45000);
					for (let i = 0; i < 8; i++) {
						await new Promise((r) => setTimeout(r, 5000));
						try {
							const res = await pod.request(4321, { path: "/" });
							const body = typeof res.body === "string" ? res.body : new TextDecoder().decode(res.body);
							log(`REQ ${res.statusCode} ${body.slice(0, 160).replace(/\s+/g, " ")}`);
							if (res.statusCode === 200) break;
						} catch (e) {
							log("req err " + (e && e.message));
						}
					}
					try { dev.kill && dev.kill(); } catch {}
					window.__state = "done";
				} catch (error) {
					log("ERR " + ((error && error.message) || String(error)));
					window.__state = "error";
				}
			})();
		</script>
	</body>
</html>
