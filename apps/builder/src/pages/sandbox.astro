---
// Tarayıcı önizlemesi (Nodepod) — cross-origin isolated sandbox.
// Repo zip'i /api/preview/bundle'dan alınır, Nodepod içinde Astro 7 build
// edilir ve dist/ statik olarak sunulur. Build başarısız olursa dev'e düşer.
export const prerender = false;
Astro.response.headers.set("Cross-Origin-Opener-Policy", "same-origin");
Astro.response.headers.set("Cross-Origin-Embedder-Policy", "require-corp");
Astro.response.headers.set("Cross-Origin-Resource-Policy", "cross-origin");
---

<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>WuppyCMS — Tarayıcı önizleme</title>
		<style>
			html, body { margin: 0; height: 100%; font-family: system-ui, sans-serif; background: #0b0b0c; color: #e5e5e5; }
			#bar { display: flex; gap: 12px; align-items: center; padding: 10px 14px; border-bottom: 1px solid #262626; font-size: 13px; }
			#bar b { color: #fff; }
			#log { position: absolute; inset: 48px 0 0 0; margin: 0; padding: 12px 14px; overflow: auto; font: 12px/1.5 ui-monospace, monospace; color: #9ae6b4; white-space: pre-wrap; }
			#frame { position: absolute; inset: 48px 0 0 0; width: 100%; height: calc(100% - 48px); border: 0; background: #fff; display: none; }
			.hidden { display: none !important; }
		</style>
	</head>
	<body>
		<div id="bar"><b>WuppyCMS</b> · tarayıcı önizleme <span id="status" style="color:#a3a3a3"></span><button id="pick" style="margin-left:auto;background:#27272a;color:#e5e5e5;border:1px solid #3f3f46;border-radius:6px;padding:4px 10px;font-size:12px;cursor:pointer">Element seç</button></div>
		<pre id="log"></pre>
		<iframe id="frame" title="Önizleme"></iframe>
		<script is:inline>
			const params = new URLSearchParams(location.search);
			const fullName = params.get("full_name") || "";
			const branch = params.get("branch") || "main";
			const logEl = document.getElementById("log");
			const statusEl = document.getElementById("status");
			const frame = document.getElementById("frame");
			const log = (m) => { logEl.textContent += m + "\n"; logEl.scrollTop = logEl.scrollHeight; };
			const clean = (t) => String(t).replace(/\x1b\[[0-9;]*m/g, "").slice(0, 300);
			const t0 = Date.now();

			async function waitPort(pod, attemptCount) {
				for (let i = 0; i < attemptCount; i++) {
					await new Promise((r) => setTimeout(r, 3000));
					try {
						const r = await pod.request(4321, { path: "/", headers: { host: "localhost:4321" } });
						if (r.statusCode === 200) return r;
					} catch {
						// henüz hazır değil
					}
				}
				return null;
			}

			function rewrite(html, prefix) {
				return html
					.replace(/\b(href|src|action|poster)=(["'])\/(?!\/)/gi, (_m, a, q) => a + "=" + q + prefix + "/")
					.replace(/\bimport\s*\(\s*(["'])\/(?!\/)/g, (_m, q) => "import(" + q + prefix + "/")
					.replace(/\bsrcset=(["'])(.*?)\1/gis, (m, q, v) =>
						"srcset=" + q + v.split(",").map((part) => part.replace(/^(\s*)\/(?!\/)/, "$1" + prefix + "/")).join(",") + q,
					)
					.replace(/url\(\s*\/(?!\/)/gi, "url(" + prefix + "/");
			}

			(async () => {
				try {
					if (!fullName) throw new Error("full_name parametresi gerekli");
					statusEl.textContent = "başlatılıyor…";
					const mod = await import("/nodepod/index.js");
					mod.setRuntimeHost(mod.createBrowserHost());
					const wsId = "wuppycms-" + fullName.replace(/[^a-z0-9]+/gi, "-") + "-" + branch;
					const pod = await mod.Nodepod.boot({
						serviceWorker: true,
						workdir: "/home/project",
						persistence: { id: wsId },
						env: { NAPI_RS_FORCE_WASI: "true" },
					});
					log("booted (" + Math.round((Date.now() - t0) / 1000) + "s)");

					const cached = await pod.fs.exists("/home/project/package.json");
					if (cached) {
						log("workspace cache'ten yüklendi (bundle atlandı)");
					} else {
						const res = await fetch(`/api/preview/bundle?full_name=${encodeURIComponent(fullName)}&branch=${encodeURIComponent(branch)}`);
						if (!res.ok) throw new Error("bundle: " + res.status);
						const info = await res.json();
						log("bundle hazır: " + Math.round(info.size / 1024 / 1024) + " MB");
						const zip = new Uint8Array(await (await fetch(info.url)).arrayBuffer());
						const fflate = await import("https://esm.sh/fflate@0.8.2");
						const files = fflate.unzipSync(zip);
						const names = Object.keys(files);
						const prefix = names[0].includes("/") ? names[0].split("/")[0] + "/" : "";
						let written = 0;
						for (const [path, data] of Object.entries(files)) {
							if (path.endsWith("/")) continue;
							const rel = prefix && path.startsWith(prefix) ? path.slice(prefix.length) : path;
							const full = "/home/project/" + rel;
							await pod.fs.mkdir(full.slice(0, full.lastIndexOf("/")), { recursive: true });
							await pod.fs.writeFile(full, data);
							written++;
						}
						log("dosyalar yazıldı: " + written);
					}

					statusEl.textContent = "npm install…";
					const install = await pod.spawn("npm", ["install", "--no-audit", "--no-fund"]);
					install.on("output", (t) => log("I:" + clean(t)));
					await install.completion;
					log("install tamam (" + Math.round((Date.now() - t0) / 1000) + "s)");

					const dir = "/home/project/node_modules/@rolldown/binding-wasm32-wasi";
					await pod.fs.mkdir(dir, { recursive: true });
					const binding = await (await fetch("/api/preview/binding")).json();
					for (const [f, url] of Object.entries(binding.files || {})) {
						const b = new Uint8Array(await (await fetch(url)).arrayBuffer());
						await pod.fs.writeFile(dir + "/" + f, b);
					}
					log("binding yazıldı");

					await pod.fs.writeFile(
						"/home/project/sandbox.config.mjs",
						`import base from "./astro.config.mjs";\nexport default {\n  ...base,\n  image: { service: { entrypoint: "astro/assets/services/noop" } },\n  vite: { ...(base.vite ?? {}), server: { ...(base.vite?.server ?? {}), allowedHosts: true } },\n};\n`,
					);

					statusEl.textContent = "build…";
					const build = await pod.spawn("npm", ["run", "build"], { env: { NAPI_RS_FORCE_WASI: "true" } });
					build.on("output", (t) => log("B:" + clean(t)));
					let built = false;
					for (let i = 0; i < 140; i++) {
						await new Promise((r) => setTimeout(r, 3000));
						if (await pod.fs.exists("/home/project/dist/index.html")) { built = true; break; }
					}
					log("build " + (built ? "tamam" : "zaman aşımı") + " (" + Math.round((Date.now() - t0) / 1000) + "s)");

					let serverUrl = null;
					if (built) {
						await pod.fs.writeFile(
							"/home/project/preview-start.mjs",
							`process.env.NAPI_RS_FORCE_WASI = "true";\nprocess.argv = ["node", "astro", "preview", "--host", "0.0.0.0", "--port", "4321"];\nawait import("./node_modules/astro/bin/astro.mjs");\n`,
						);
						const srv = await pod.spawn("node", ["preview-start.mjs"]);
						srv.on("output", (t) => log("P:" + clean(t)));
						serverUrl = await waitPort(pod, 40);
					}

					if (!serverUrl) {
						statusEl.textContent = "dev (yedek)…";
						await pod.fs.writeFile(
							"/home/project/sandbox-start.mjs",
							`process.env.NAPI_RS_FORCE_WASI = "true";\nimport { existsSync } from "node:fs";\nif (existsSync("./scripts/build-entries.mjs")) { await import("./scripts/build-entries.mjs"); }\nprocess.argv = ["node", "astro", "dev", "--config", "sandbox.config.mjs", "--host", "0.0.0.0", "--port", "4321"];\nawait import("./node_modules/astro/bin/astro.mjs");\n`,
						);
						const dev = await pod.spawn("node", ["sandbox-start.mjs"]);
						dev.on("output", (t) => log("D:" + clean(t)));
						serverUrl = await waitPort(pod, 60);
					}
					if (!serverUrl) throw new Error("sunucu zaman aşımı");

					const html = new TextDecoder().decode(serverUrl.body);
					log("HTML " + html.length + " h1=" + html.includes("<h1") + " hero=" + html.includes("HIZLI VE GÜVENİLİR") + " main=" + html.includes("<main"));
					(window as any).__devHtml = html;
					const prefix = "/__virtual__/" + encodeURIComponent(pod.instanceId) + "/4321";
					logEl.classList.add("hidden");
					frame.style.display = "block";
					frame.srcdoc = rewrite(html, prefix);
					statusEl.textContent = "canlı (" + Math.round((Date.now() - t0) / 1000) + "s)";

					let picking = false;
					const pickBtn = document.getElementById("pick");
					pickBtn.addEventListener("click", () => {
						picking = !picking;
						pickBtn.textContent = picking ? "Seçimi bitir" : "Element seç";
						try { frame.contentWindow.postMessage({ type: "wuppycms:pick-mode", on: picking }, location.origin); } catch {}
					});
					window.addEventListener("message", (event) => {
						const data = event.data;
						if (!data || typeof data.type !== "string") return;
						if (data.type === "wuppycms:pick" && data.selection) {
							try {
								window.opener &&
									window.opener.postMessage({ type: "wuppycms:sandbox:pick", selection: data.selection }, location.origin);
							} catch {}
						}
					});
				} catch (error) {
					statusEl.textContent = "hata";
					log("HATA " + (error && error.message ? error.message : error));
				}
			})();
		</script>
	</body>
</html>
