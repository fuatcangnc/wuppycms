---
// Projeler ekranı (dashboard) — TuranCMS'teki dashboard karşılığı.
// Koruma: oturum yoksa /login'e yönlendirir. Liste D1'den sunucuda sorgulanır,
// çizim ve oluşturma akışı React adasında (ProjectsIsland).
import ProjectsIsland from "@/components/projects/ProjectsIsland";
import Layout from "@/layouts/Layout.astro";
import { getSession, getEnv } from "@/lib/session";

const session = await getSession(Astro);
if (!session) return Astro.redirect("/login?next=/projects");

const env = getEnv(Astro);
const result = await env.DB!.prepare(
	"SELECT id, name, repo_full_name, default_branch, created_at FROM projects WHERE user_id = ? ORDER BY created_at DESC",
)
	.bind(session.user!.id)
	.all<{
		id: string;
		name: string;
		repo_full_name: string;
		default_branch: string;
		created_at: string;
	}>();
const projects = result.results ?? [];
const userName = session.user?.name || session.user?.email || "";
---

<Layout>
	{/* Diller istemcide seçiliyor (kalıcı tercih) — SSR/istemci uyuşmazlığı olmaması için client:only. */}
	<ProjectsIsland client:only="react" projects={projects} userName={userName} />
</Layout>
