# WuppyCMS — AWS Lambda (container) imajı.
# Build: docker build -f Dockerfile.aws -t wuppycms-app .
# Lambda: AWS Lambda Web Adapter katmanı + AWS_LAMBDA_EXEC_WRAPPER=/opt/bootstrap

FROM public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 AS lambda-adapter

ARG LITESTREAM_VERSION=0.3.13
ARG ROUTER_VERSION=0.5.112

FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@12.11.2 --activate
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/builder/package.json apps/builder/package.json
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @wuppycms/builder build:aws

FROM node:22-bookworm-slim
WORKDIR /app/apps/builder
ENV NODE_ENV=production PORT=8080
ARG LITESTREAM_VERSION=0.3.13
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates
RUN npm i -g 9router@${ROUTER_VERSION} \
 && curl -fsSL "https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM_VERSION}/litestream-v${LITESTREAM_VERSION}-linux-amd64.tar.gz" \
    | tar -xz -C /usr/local/bin litestream \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/builder/node_modules ./node_modules
COPY --from=build /app/apps/builder/dist ./dist
COPY --from=build /app/apps/builder/dist-node ./dist-node
COPY --from=build /app/apps/builder/server-node.mjs ./server-node.mjs
COPY --from=build /app/apps/builder/db ./db
COPY --from=build /app/apps/builder/litestream.yml ./litestream.yml
COPY --from=build /app/apps/builder/entrypoint.sh ./entrypoint.sh
COPY apps/builder/.9router-data /app/.9router-data
RUN find /app/.9router-data -type d -exec chmod 755 {} + && find /app/.9router-data -type f -exec chmod 644 {} +
COPY --from=lambda-adapter /lambda-adapter /opt/extensions/lambda-adapter
ENV AWS_LWA_PORT=8080
EXPOSE 8080
CMD ["./entrypoint.sh"]
