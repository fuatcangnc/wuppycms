---
import { ArrowRight, Check, FileCode2, ShieldCheck } from "@lucide/astro";
import { supported } from "@/data/site";
---

<section class="border-b border-neutral-200 bg-neutral-50/60 py-20 lg:py-28" id="teknoloji">
	<div class="shell">
		<div class="mx-auto mb-14 max-w-4xl text-center" data-reveal>
			<div class="inline-block">
				<span class="inline-block -skew-x-12 bg-neutral-950 px-5 py-1.5 text-xs font-black uppercase tracking-[0.2em] text-white">
					<span class="inline-block skew-x-12">Desteklenen içerik ve teknolojiler</span>
				</span>
			</div>
			<h2 class="mt-5 text-3xl font-black uppercase leading-tight tracking-tight text-neutral-950 sm:text-4xl lg:text-5xl">
				Senin stack'in, <span class="text-primary">senin içeriğin.</span>
			</h2>
			<p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-neutral-600 sm:text-base">
				Astro, MDX, Markdown, Tailwind 4 ve Cloudflare. Tasarım token'ları ve Bejamas UI
				bileşenleriyle üretime hazır bir başlangıç.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
			{
				supported.map((item) => (
					<div class="group relative flex flex-col justify-between border border-neutral-200 bg-white p-5 shadow-xs transition-all duration-300 hover:border-primary/60 hover:shadow-md">
						<div class="absolute inset-x-0 top-0 h-1 bg-neutral-200 transition-colors group-hover:bg-primary"></div>
						<div>
							<div class="flex h-20 w-full items-center justify-center border border-neutral-200/80 bg-neutral-50/70 p-3 transition-colors group-hover:border-neutral-300 group-hover:bg-white">
								<span class="font-mono text-lg font-black uppercase tracking-[-0.04em] text-neutral-950 transition-transform duration-300 group-hover:scale-105">
									{item.name}
								</span>
							</div>
							<div class="mt-4 flex items-center justify-between border-b border-neutral-100 pb-3">
								<h3 class="text-base font-black uppercase tracking-tight text-neutral-950">{item.name}</h3>
								<span class="bg-neutral-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-neutral-600">
									{item.badge}
								</span>
							</div>
							<p class="mt-3 text-xs font-medium leading-relaxed text-neutral-600">{item.note}</p>
							<div class="mt-4 flex items-center gap-1.5 text-[11px] font-bold text-neutral-500">
								<span class="grid size-4 place-items-center rounded-full bg-primary/10 text-primary">
									<Check size={11} stroke-width={3} />
								</span>
								<span>Şablonda hazır</span>
							</div>
						</div>
						<div class="mt-6 border-t border-neutral-100 pt-4">
							<div class="mb-3 flex items-center gap-1.5 text-[11px] font-bold text-neutral-500">
								<ShieldCheck size={13} class="shrink-0 text-emerald-600" />
								<span>Üretim uyumlu</span>
							</div>
							<a
								href="/#iletisim"
								class="group/btn flex w-full items-center justify-between border border-neutral-300 bg-neutral-50 px-3 py-2 text-xs font-black uppercase tracking-wider text-neutral-900 transition-all hover:border-primary hover:bg-primary hover:text-white"
							>
								<span>Şablonu gör</span>
								<ArrowRight size={13} class="transition-transform group-hover/btn:translate-x-1" />
							</a>
						</div>
					</div>
				))
			}
		</div>

		<div class="mt-10 border border-neutral-200 bg-white p-6 shadow-xs sm:p-8" data-reveal>
			<div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
				<div class="flex items-start gap-4">
					<div class="grid size-12 shrink-0 place-items-center rounded-xl border border-primary/20 bg-primary/10 text-primary">
						<FileCode2 size={24} stroke-width={2.2} />
					</div>
					<div>
						<div class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary">
							<span>İçerik modeli genişletilebilir</span>
						</div>
						<h3 class="mt-1 text-lg font-black uppercase tracking-tight text-neutral-950 sm:text-xl">
							Listede olmayan bir içerik tipi mi var?
						</h3>
						<p class="mt-1.5 max-w-2xl text-xs leading-relaxed text-neutral-600 sm:text-sm">
							Koleksiyon şemasını ve sayfa ağacını kendi içerik modelinize göre genişletebiliriz.
						</p>
					</div>
				</div>
				<a
					href="/#iletisim"
					class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 bg-primary px-7 text-xs font-black uppercase tracking-wider text-white transition-colors hover:bg-[#b84d12]"
				>
					<span>Konuşalım</span>
					<ArrowRight size={15} />
				</a>
			</div>
		</div>
	</div>
</section>
