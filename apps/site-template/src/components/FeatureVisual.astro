---
interface Props {
	type: "ai" | "git" | "panel" | "astro" | "team" | "selfhost";
}

const { type } = Astro.props;
const labels: Record<Props["type"], string> = {
	ai: "AI editör",
	git: "Git akışı",
	panel: "Sayfa ağacı",
	astro: "Astro altyapısı",
	team: "Ekip akışı",
	selfhost: "Self-host",
};
---

<div class="absolute inset-0 overflow-hidden bg-[#0B0E11] text-white">
	<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#ffffff14_1px,transparent_1px)] [background-size:16px_16px]" aria-hidden="true"></div>
	<div class="relative flex h-full flex-col p-3">
		<div class="flex items-center justify-between border-b border-white/10 pb-2 font-mono text-[8px] uppercase tracking-[0.14em] text-white/40">
			<span class="inline-flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-primary"></span>{labels[type]}</span>
			<span>wuppy / 01</span>
		</div>

		{
			type === "ai" && (
				<div class="flex flex-1 flex-col justify-between pt-3">
					<div class="border border-primary/25 bg-primary/10 p-2">
						<p class="font-mono text-[8px] uppercase tracking-wider text-primary">AI isteği</p>
						<p class="mt-1 font-mono text-[9px] leading-4 text-white/80">"Hero başlığını daha net yap, altına CTA ekle."</p>
					</div>
					<div class="mt-2 space-y-1 font-mono text-[8px] leading-4">
						<p class="text-white/30">- &lt;h1&gt;Hoş geldiniz&lt;/h1&gt;</p>
						<p class="bg-emerald-500/10 px-1 text-emerald-300">+ &lt;h1&gt;İçerik repoda yaşar&lt;/h1&gt;</p>
						<p class="bg-emerald-500/10 px-1 text-emerald-300">+ &lt;Button&gt;Demo talep et&lt;/Button&gt;</p>
					</div>
					<div class="flex items-center justify-between border-t border-white/10 pt-2 font-mono text-[8px] text-white/40">
						<span class="text-emerald-400">diff hazır</span>
						<span class="border border-primary/30 px-1.5 py-0.5 text-primary">Onayla ↵</span>
					</div>
				</div>
			)
		}

		{
			type === "git" && (
				<div class="relative flex flex-1 items-center pt-3">
					<div class="absolute bottom-3 left-[18px] top-5 w-px bg-white/15"></div>
					<div class="space-y-2.5">
						{["AI: hero güncellendi", "içerik: blog eklendi", "tasarım: token güncellendi"].map((msg, i) => (
							<div class="relative flex items-center gap-2 pl-0">
								<span class={`relative z-10 grid size-3 place-items-center ${i === 0 ? "bg-primary" : "border border-white/25 bg-[#0B0E11]"}`}>
									<span class="size-1 rounded-full bg-[#0B0E11]"></span>
								</span>
								<div class="border border-white/10 bg-white/[0.03] px-2 py-1 font-mono text-[8px] text-white/65">
									{msg}
								</div>
							</div>
						))}
					</div>
					<div class="absolute bottom-4 right-2 border border-primary/30 bg-primary/10 px-2 py-1 font-mono text-[8px] text-primary">
						3f2a1c
					</div>
				</div>
			)
		}

		{
			type === "panel" && (
				<div class="grid flex-1 grid-cols-[1fr_1.2fr] gap-2 pt-3 font-mono text-[8px]">
					<div class="border border-white/10 p-2">
						<p class="text-[7px] uppercase tracking-wider text-white/30">src / pages</p>
						<p class="mt-1.5 text-primary">index.astro</p>
						<p class="pl-2 text-white/55">blog/</p>
						<p class="pl-4 text-white/55">[...slug].astro</p>
						<p class="pl-2 text-white/55">hakkimizda.astro</p>
					</div>
					<div class="border border-white/10 bg-white/[0.03] p-2">
						<p class="text-[7px] uppercase tracking-wider text-white/30">içerik</p>
						<p class="mt-1.5 text-white/70">3 yazı · 2 yazar</p>
						<div class="mt-2 h-1 w-full bg-white/10"><div class="h-full w-2/3 bg-primary"></div></div>
						<p class="mt-2 text-[7px] text-white/40">medya: R2</p>
						<div class="mt-1 grid grid-cols-3 gap-1">
							<span class="aspect-square bg-white/10"></span>
							<span class="aspect-square bg-white/10"></span>
							<span class="aspect-square bg-primary/30"></span>
						</div>
					</div>
				</div>
			)
		}

		{
			type === "astro" && (
				<div class="flex flex-1 flex-col justify-center pt-3">
					<div class="grid grid-cols-2 gap-1.5 font-mono text-[8px]">
						{["Astro", "Tailwind 4", "Bejamas", "Cloudflare"].map((name) => (
							<div class="flex items-center gap-1.5 border border-white/10 bg-white/[0.03] px-2 py-1.5 text-white/70">
								<span class="size-1.5 bg-primary"></span>{name}
							</div>
						))}
					</div>
					<div class="mt-3 border-t border-white/10 pt-2 font-mono text-[8px] text-white/40">
						<span class="text-emerald-400">✓</span> static output · 0 client JS zorunlu
					</div>
				</div>
			)
		}

		{
			type === "team" && (
				<div class="flex flex-1 flex-col justify-center gap-1.5 pt-3">
					{[
						["FY", "Fuat", "Yönetici"],
						["AY", "Ayşe", "Editör"],
						["MK", "Mert", "Yazar"],
					].map(([initials, name, role]) => (
						<div class="flex items-center gap-2 border border-white/10 bg-white/[0.03] px-2 py-1.5">
							<span class="grid size-5 place-items-center bg-primary text-[7px] font-black text-white">{initials}</span>
							<span class="font-mono text-[8px] text-white/75">{name}</span>
							<span class="ml-auto font-mono text-[7px] uppercase tracking-wider text-white/35">{role}</span>
						</div>
					))}
					<div class="mt-1 border border-primary/25 bg-primary/10 px-2 py-1 font-mono text-[8px] text-primary">
						+ davet gönder
					</div>
				</div>
			)
		}

		{
			type === "selfhost" && (
				<div class="flex flex-1 flex-col justify-center pt-3">
					<div class="grid grid-cols-3 gap-1.5 text-center font-mono text-[8px]">
						{["Workers", "D1", "R2"].map((name) => (
							<div class="border border-white/10 bg-white/[0.03] px-1 py-2">
								<span class="mx-auto mb-1 block size-1.5 bg-primary"></span>
								<span class="text-white/65">{name}</span>
							</div>
						))}
					</div>
					<div class="mt-2 border-t border-white/10 pt-2 font-mono text-[8px] text-white/40">
						<span class="text-primary">●</span> kendi hesabında · vendor lock-in yok
					</div>
				</div>
			)
		}
	</div>
</div>
