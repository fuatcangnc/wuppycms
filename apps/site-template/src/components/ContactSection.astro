---
import { ArrowRight, Mail } from "@lucide/astro";
import ProjectForm from "./ProjectForm.astro";
import { siteSettings } from "@/data/site";

const points = [
	["01", "Hızlı ön görüşme", "Reponuzu ve içerik hacminizi inceleyip demo kapsamını netleştiririz."],
	["02", "Kendi stack'iniz", "Astro, Tailwind 4 ve Bejamas UI; mevcut tasarım sisteminize uyarlanır."],
	["03", "Git'te kalır", "İçerik ve geçmiş sizin reponuzda kalır; vendor lock-in yok."],
];
---

<section class="border-y border-neutral-200 bg-[#f8f9fa] py-20 lg:py-28" id="iletisim">
	<div class="shell grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
		<div class="flex flex-col justify-between lg:col-span-5" data-reveal>
			<div>
				<div class="inline-block">
					<span class="inline-block -skew-x-12 bg-neutral-950 px-4 py-1 text-[11px] font-black uppercase tracking-[0.2em] text-white">
						<span class="inline-block skew-x-12">Demo & iletişim</span>
					</span>
				</div>

				<h2 class="mt-5 text-3xl font-black uppercase leading-[1.06] tracking-tight text-neutral-950 sm:text-4xl lg:text-5xl">
					Reponuzu bağlayalım, <span class="text-primary">birlikte yayınlayalım.</span>
				</h2>

				<p class="mt-4 text-sm font-normal leading-relaxed text-neutral-600 sm:text-base">
					Mevcut sitenizi, içerik tipinizi ve ekibinizi anlatın; demo ortamında birlikte
					deneyelim.
				</p>

				<div class="mt-8 space-y-3">
					{
						points.map(([number, title, description]) => (
							<div class="flex items-start gap-3.5 border border-neutral-200 bg-white p-3.5">
								<div class="grid size-7 shrink-0 place-items-center bg-primary font-mono text-xs font-black text-white">
									{number}
								</div>
								<div>
									<h3 class="text-xs font-black uppercase tracking-tight text-neutral-950">{title}</h3>
									<p class="mt-0.5 text-xs leading-normal text-neutral-600">{description}</p>
								</div>
							</div>
						))
					}
				</div>

				<div class="mt-8 border-l-4 border-primary bg-neutral-950 p-6 text-white shadow-md">
					<div class="flex items-center justify-between gap-2">
						<span class="text-[11px] font-bold uppercase tracking-wider text-primary">Doğrudan iletişim</span>
						<span class="inline-flex items-center gap-1.5 border border-emerald-800/60 bg-emerald-950/60 px-2 py-0.5 text-[10px] font-bold text-emerald-400">
							<span class="size-2 animate-pulse rounded-full bg-emerald-400"></span>
							Çevrimiçi
						</span>
					</div>
					<div class="mt-3 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
						<a
							href={`mailto:${siteSettings.email}`}
							class="inline-flex items-center gap-2 text-lg font-black tracking-tight text-white transition-colors hover:text-primary sm:text-2xl"
						>
							<Mail size={18} /> {siteSettings.email}
						</a>
						<a
							href={`mailto:${siteSettings.email}?subject=WuppyCMS%20demo%20talebi`}
							class="inline-flex min-h-11 items-center justify-center gap-2 bg-primary px-5 text-xs font-black uppercase tracking-wider text-white shadow-sm transition-all duration-200 hover:scale-[1.02] hover:bg-[#b84d12]"
						>
							<span>E-posta gönder</span>
							<ArrowRight class="size-4" />
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class="lg:col-span-7" data-reveal>
			<ProjectForm hideHeading />
		</div>
	</div>
</section>
