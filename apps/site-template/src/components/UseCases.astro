---
import { ArrowRight } from "@lucide/astro";
import { useCases } from "@/data/site";
---

<section class="border-b border-neutral-200 bg-white py-16 md:py-24" id="kullanim">
	<div class="shell">
		<div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
			<div>
				<div class="inline-flex items-center gap-2 border border-primary/30 bg-primary/5 px-3.5 py-1 text-[11px] font-black uppercase tracking-[0.16em] text-primary shadow-2xs">
					<span class="size-2 animate-pulse rounded-full bg-primary"></span>
					<span>Kimler için?</span>
				</div>
				<h2 class="mt-4 text-2xl font-black uppercase leading-[1.1] tracking-tight text-neutral-950 sm:text-3xl md:text-4xl lg:text-5xl">
					Tek içerik modeli, <span class="text-primary">farklı kullanım senaryoları.</span>
				</h2>
				<p class="mt-3 max-w-3xl text-sm leading-relaxed text-neutral-600 sm:text-base">
					Blogdan dokümantasyona, landing page'den kurumsal siteye. Aynı Git tabanlı içerik
					modeli ve tasarım sistemiyle farklı sayfa tipleri kurun.
				</p>
			</div>
			<a
				href="/blog"
				class="inline-flex h-12 shrink-0 items-center gap-2 self-start border border-neutral-900 bg-white px-6 text-xs font-black uppercase tracking-wider text-neutral-950 transition-colors hover:bg-neutral-950 hover:text-white md:self-end"
			>
				<span>Blogu oku</span>
				<ArrowRight size={15} />
			</a>
		</div>

		<div class="mt-10 flex flex-col items-stretch justify-between gap-4 border-b border-neutral-200 pb-5 sm:flex-row sm:items-center">
			<div class="inline-flex rounded-xs border border-neutral-200 bg-neutral-100 p-1 text-xs" id="usecase-tabs" role="tablist">
				<button
					type="button"
					data-usecase-tab="all"
					class="usecase-tab border border-neutral-200/60 bg-white px-3.5 py-2 font-black uppercase tracking-wider text-neutral-950 shadow-2xs transition-all"
				>
					Tümü <span class="ml-1 text-[11px] font-bold text-neutral-400">({useCases.length})</span>
				</button>
				<button
					type="button"
					data-usecase-tab="İçerik"
					class="usecase-tab px-3.5 py-2 font-bold uppercase tracking-wider text-neutral-600 transition-all hover:text-neutral-950"
				>
					İçerik
				</button>
				<button
					type="button"
					data-usecase-tab="Ürün"
					class="usecase-tab px-3.5 py-2 font-bold uppercase tracking-wider text-neutral-600 transition-all hover:text-neutral-950"
				>
					Ürün
				</button>
			</div>
			<span class="text-xs font-medium text-neutral-500" id="usecase-count">{useCases.length} senaryo</span>
		</div>

		<div class="mt-4 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3" id="usecase-grid">
			{
				useCases.map((item, index) => (
					<a
						href={item.href}
						data-usecase-card
						data-usecase-side={item.side}
						class="group flex items-center justify-between border border-neutral-200/90 bg-white p-3 transition-all duration-150 hover:border-primary hover:bg-neutral-50 hover:shadow-xs"
					>
						<div class="flex min-w-0 items-center gap-2.5">
							<span class="flex size-6 shrink-0 items-center justify-center bg-neutral-100 font-mono text-[10px] font-bold text-neutral-500 transition-colors group-hover:bg-primary group-hover:text-white">
								{String(index + 1).padStart(2, "0")}
							</span>
							<div class="min-w-0">
								<span class="block truncate text-xs font-black uppercase tracking-tight text-neutral-900 transition-colors group-hover:text-primary sm:text-sm">
									{item.title}
								</span>
								<span class="block text-[10px] font-semibold text-neutral-400 transition-colors group-hover:text-neutral-600">
									{item.side} · {item.description}
								</span>
							</div>
						</div>
						<div class="shrink-0 pl-2">
							<span class="inline-flex size-6 items-center justify-center bg-neutral-100 text-neutral-400 transition-colors group-hover:bg-primary group-hover:text-white">
								<ArrowRight size={12} class="transition-transform group-hover:translate-x-0.5" />
							</span>
						</div>
					</a>
				))
			}
		</div>

		<div class="mt-8 flex flex-wrap items-center justify-between gap-4 border border-neutral-200 bg-neutral-50/70 p-5 sm:p-6" data-reveal>
			<div>
				<p class="text-[11px] font-black uppercase tracking-wider text-primary">Şablonu genişlet</p>
				<p class="mt-1 text-sm font-bold text-neutral-900">Kendi içerik modelinizi mi kuruyorsunuz?</p>
			</div>
			<a href="/#iletisim" class="inline-flex items-center gap-2 bg-neutral-950 px-5 py-3 text-xs font-black uppercase tracking-wider text-white transition-colors hover:bg-primary">
				Konuşalım <ArrowRight size={14} />
			</a>
		</div>
	</div>
</section>

<script is:inline>
	document.addEventListener("DOMContentLoaded", () => {
		const tabs = document.querySelectorAll("[data-usecase-tab]");
		const cards = document.querySelectorAll("[data-usecase-card]");
		const count = document.querySelector("#usecase-count");
		if (!tabs.length) return;

		function filter(value) {
			let visible = 0;
			cards.forEach((card) => {
				const matches = value === "all" || card.getAttribute("data-usecase-side") === value;
				card.style.display = matches ? "" : "none";
				if (matches) visible++;
			});
			if (count) count.textContent = `${visible} senaryo`;
			tabs.forEach((tab) => {
				const active = tab.getAttribute("data-usecase-tab") === value;
				tab.classList.toggle("bg-white", active);
				tab.classList.toggle("border", active);
				tab.classList.toggle("border-neutral-200/60", active);
				tab.classList.toggle("shadow-2xs", active);
				tab.classList.toggle("text-neutral-950", active);
				tab.classList.toggle("font-bold", !active);
				tab.classList.toggle("text-neutral-600", !active);
			});
		}

		tabs.forEach((tab) => {
			tab.addEventListener("click", () => filter(tab.getAttribute("data-usecase-tab") || "all"));
		});
	});
</script>
