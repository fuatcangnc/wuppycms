---
import { ArrowRight, CalendarDays, Clock } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";

interface Props {
	posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
const formatDate = (date: Date) =>
	date.toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" });
const readTime = (body: string) => `${Math.max(1, Math.ceil(body.split(/\s+/).length / 200))} dk`;
const tones = ["dark", "orange", "light"] as const;
---

<section class="border-b border-neutral-200 bg-white py-16 md:py-24" id="blog">
	<div class="shell">
		<div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
			<div>
				<div class="inline-flex items-center gap-2 border border-neutral-300 bg-neutral-100 px-3.5 py-1 text-[11px] font-black uppercase tracking-[0.16em] text-neutral-900">
					<span class="size-2 animate-pulse rounded-full bg-primary"></span>
					<span>WuppyCMS journal</span>
				</div>
				<h2 class="mt-4 text-3xl font-black uppercase leading-tight tracking-tight text-neutral-950 sm:text-4xl lg:text-5xl">
					İçerik, kod ve <span class="text-primary">AI notları.</span>
				</h2>
				<p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600 sm:text-base">
					Git tabanlı içerik, Astro, tasarım sistemleri ve AI destekli editör üzerine yazılar.
				</p>
			</div>
			<a
				href="/blog"
				class="inline-flex h-12 shrink-0 items-center gap-2 border border-neutral-900 bg-white px-6 text-xs font-black uppercase tracking-wider text-neutral-950 transition-colors hover:bg-neutral-950 hover:text-white md:self-end"
			>
				<span>Tüm yazılar</span>
				<ArrowRight size={15} />
			</a>
		</div>

		<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
			{
				posts.map((post, index) => {
					const tone = tones[index % tones.length];
					const tag = post.data.tags[0] || "İçerik";
					return (
						<article class="group flex flex-col border border-neutral-200 bg-white transition-all duration-200 hover:border-primary hover:shadow-sm">
							<a href={`/blog/${post.id}`} class="block overflow-hidden border-b border-neutral-200">
								<div
									class:list={[
										"relative flex aspect-[16/9] flex-col justify-between overflow-hidden p-5",
										tone === "dark" && "bg-[#0B0E11] text-white",
										tone === "orange" && "bg-primary text-white",
										tone === "light" && "bg-neutral-100 text-neutral-950",
									]}
								>
									<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(currentColor_1px,transparent_1px)] [background-size:18px_18px] opacity-[0.12]" aria-hidden="true"></div>
									<div class="relative flex items-center justify-between font-mono text-[10px] font-bold uppercase tracking-[0.16em]">
										<span>{tag}</span>
										<span>{String(index + 1).padStart(2, "0")}</span>
									</div>
									<div class="relative flex items-end justify-between gap-3">
										<span class="font-mono text-[clamp(2rem,4vw,3.5rem)] font-black leading-none tracking-[-0.08em] opacity-20">
											{post.data.title.slice(0, 1)}
										</span>
										<span class="text-right font-mono text-[9px] uppercase tracking-[0.14em] opacity-60">
											{post.data.author}
										</span>
									</div>
								</div>
							</a>
							<div class="flex flex-1 flex-col p-5 sm:p-6" data-wuppycms-content={JSON.stringify({ collection: "blog", slug: post.id })}>
								<div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-wider">
									<span class="bg-primary/10 px-2 py-0.5 text-primary">{tag}</span>
								</div>
								<h3
									class="mt-3 text-base font-black leading-tight text-neutral-950 transition-colors group-hover:text-primary sm:text-lg"
									data-wuppycms-field="title"
								>
									<a href={`/blog/${post.id}`}>{post.data.title}</a>
								</h3>
								<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-600" data-wuppycms-field="description">
									{post.data.description}
								</p>
								<div class="mt-auto flex items-center justify-between pt-4 text-[11px] text-neutral-500">
									<span class="inline-flex items-center gap-1.5">
										<CalendarDays size={13} />
										{formatDate(post.data.pubDate)}
									</span>
									<span class="inline-flex items-center gap-1.5">
										<Clock size={13} />
										{readTime(post.body ?? "")}
									</span>
								</div>
								<a
									href={`/blog/${post.id}`}
									class="mt-4 inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary transition-all group-hover:gap-3"
								>
									Yazıyı oku <ArrowRight size={14} />
								</a>
							</div>
						</article>
					);
				})
			}
		</div>

		{posts.length === 0 && <p class="py-12 text-center text-sm text-neutral-500">Henüz yazı yok.</p>}
	</div>
</section>
