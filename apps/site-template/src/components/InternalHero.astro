---
import { ArrowRight } from "@lucide/astro";

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	breadcrumbTitle?: string;
}

const { eyebrow, title, description, breadcrumbTitle } = Astro.props;
const breadcrumbLabel = breadcrumbTitle || eyebrow;
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
---

<section class="internal-hero relative">
	<div class="internal-hero__image internal-hero__blueprint" aria-hidden="true"></div>
	<div class="internal-hero__wash"></div>
	<div class="shell internal-hero__content">
		<h2 class="eyebrow">{eyebrow}</h2>
		<h1>{title}</h1>
		<p class="internal-hero__description">{description}</p>
		<nav class="breadcrumbs" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
			<span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
				<a itemprop="item" href="/"><span itemprop="name">Ana Sayfa</span></a>
				<meta itemprop="position" content="1" />
			</span>
			<ArrowRight size={13} aria-hidden="true" />
			<span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
				<span itemprop="name">{breadcrumbLabel}</span>
				<meta itemprop="item" content={canonical} />
				<meta itemprop="position" content="2" />
			</span>
		</nav>
	</div>

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": new URL("/", Astro.url.origin).href },
			{ "@type": "ListItem", "position": 2, "name": breadcrumbLabel, "item": canonical },
		],
	})} />

	<div class="custom-divider-white-left pointer-events-none absolute -bottom-[1px] left-0 z-20 border-0 shadow-none outline-none" aria-hidden="true"></div>
	<div class="custom-divider-white-right pointer-events-none absolute -bottom-[1px] right-0 z-20 border-0 shadow-none outline-none" aria-hidden="true"></div>
</section>

<style>
	.internal-hero__blueprint {
		background:
			radial-gradient(#d4d4d4 1.25px, transparent 1.25px) 0 0 / 22px 22px,
			linear-gradient(135deg, transparent 0 54.8%, rgba(221, 100, 30, 0.16) 54.8% 55.2%, transparent 55.2%),
			linear-gradient(45deg, transparent 0 64.8%, rgba(17, 17, 17, 0.08) 64.8% 65.2%, transparent 65.2%),
			linear-gradient(180deg, #fafafa, #f0f0f0);
	}
	.internal-hero__blueprint::after {
		position: absolute;
		right: 7%;
		bottom: 12%;
		color: rgba(17, 17, 17, 0.08);
		font-family: var(--font-mono), monospace;
		font-size: clamp(6rem, 14vw, 15rem);
		font-weight: 700;
		letter-spacing: -0.08em;
		content: "{ }";
	}
</style>
