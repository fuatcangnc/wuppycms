---
import { ArrowRight, GitBranch, Mail, Terminal } from "@lucide/astro";
import { siteSettings } from "@/data/site";

interface Props {
	eyebrow?: string;
	title?: string;
	description?: string;
}

const {
	eyebrow = "İçerik yönetimini yeniden düşünün",
	title = "Reponuzu bağlayın. İçeriğinizi AI ile düzenleyin.",
	description = "WuppyCMS; Astro sitenizi GitHub'a bağlar, AI ile içerik üretmenizi sağlar ve her değişikliği gerçek bir commit olarak saklar. Kurulum yok, kilit yok.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-white text-neutral-950">
	<div class="shell relative isolate grid min-h-[24rem] items-center overflow-hidden lg:min-h-[26rem] lg:grid-cols-[.9fr_1.1fr] lg:gap-8">
		<!-- Sol: commit terminali -->
		<div class="relative hidden h-full items-center lg:flex" aria-hidden="true">
			<div class="relative w-full max-w-[30rem] -rotate-1 border border-neutral-200 bg-neutral-100 p-3 shadow-[0_30px_70px_-30px_rgba(0,0,0,.45)]">
				<div class="absolute -left-3 top-10 h-16 w-1.5 bg-primary"></div>
				<div class="border border-white/10 bg-[#0B0E11] p-1">
					<div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
						<span class="inline-flex items-center gap-2 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-white/50">
							<Terminal size={13} class="text-primary" /> wuppycms / terminal
						</span>
						<span class="flex gap-1.5">
							<span class="size-2 rounded-full bg-white/20"></span>
							<span class="size-2 rounded-full bg-white/20"></span>
							<span class="size-2 rounded-full bg-primary"></span>
						</span>
					</div>
					<pre class="overflow-hidden p-5 font-mono text-[11px] leading-6 text-white/72 sm:text-xs"><span class="text-primary">$</span> git status
<span class="text-white/40">On branch</span> main
<span class="text-emerald-400">Your branch is up to date</span> with 'origin/main'.

<span class="text-primary">Changes not staged for commit:</span>
  <span class="text-white/40">modified:</span>   src/pages/index.astro
  <span class="text-white/40">new file:</span>   src/components/sections/About.astro

<span class="text-primary">$</span> git add . && git commit -m <span class="text-amber-300">"AI: hero ve hakkımızda güncellendi"</span>
<span class="text-emerald-400">[main 3f2a1c]</span> 2 files changed, 48 insertions(+)
<span class="text-primary">$</span> <span class="animate-pulse">▍</span></pre>
					<div class="flex items-center justify-between border-t border-white/10 px-4 py-2.5 font-mono text-[10px] text-white/45">
						<span class="inline-flex items-center gap-1.5"><GitBranch size={12} class="text-primary" /> main</span>
						<span class="text-emerald-400">build: passed</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Sağ: içerik -->
		<div class="relative z-10 flex flex-col justify-center gap-5 py-12 pl-0 lg:col-start-2 lg:py-14 lg:pl-6">
			<span class="text-xs font-black uppercase tracking-[.18em] text-primary">{eyebrow}</span>
			<h2 class="max-w-2xl text-3xl font-black uppercase leading-[1.02] tracking-[-0.04em] text-neutral-950 sm:text-4xl md:text-5xl">
				{title}
			</h2>
			<p class="max-w-xl text-sm leading-relaxed text-neutral-600">
				{description}
			</p>

			<div class="flex flex-wrap gap-3 pt-2">
				<a
					class="inline-flex min-h-12 items-center justify-center gap-3 bg-primary px-6 text-xs font-black uppercase tracking-wider !text-white shadow-md shadow-primary/20 transition-all duration-300 hover:scale-[1.02] hover:bg-[#b84d12]"
					href="/#iletisim"
				>
					<span>Demo talep et</span>
					<ArrowRight size={16} />
				</a>
				<a
					class="inline-flex min-h-12 items-center justify-center gap-3 border-2 border-neutral-950 bg-transparent px-6 text-xs font-black uppercase tracking-wider !text-neutral-950 transition-all duration-300 hover:scale-[1.02] hover:bg-neutral-950 hover:!text-white"
					href="/blog"
				>
					<span>Blogu oku</span>
					<ArrowRight size={16} />
				</a>
			</div>

			<div class="flex items-center gap-4 pt-3 sm:pt-2">
				<span class="grid size-12 shrink-0 place-items-center bg-black text-white sm:size-14">
					<GitBranch size={22} class="sm:size-6" />
				</span>
				<div class="flex flex-col">
					<span class="text-xs font-black uppercase tracking-wider text-primary">Reponu bağla</span>
					<a
						href={`mailto:${siteSettings.email}`}
						class="mt-0.5 inline-flex items-center gap-1.5 text-lg font-black uppercase !text-neutral-950 transition-colors hover:!text-primary sm:text-2xl"
					>
						<Mail size={16} /> {siteSettings.email}
					</a>
				</div>
			</div>
		</div>
	</div>

	<!-- Geometrik siyah geçiş -->
	<div class="custom-divider-black-left pointer-events-none absolute -bottom-[1px] left-0 z-10 border-0 shadow-none outline-none" aria-hidden="true"></div>
	<div class="custom-divider-black-right pointer-events-none absolute -bottom-[1px] right-0 z-10 border-0 shadow-none outline-none" aria-hidden="true"></div>
</section>
