---
import "@/styles/global.css";
import { Font } from "astro:assets";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import FloatingCta from "@/components/FloatingCta.astro";
import WuppycmsBridge from "@/components/WuppycmsBridge.astro";
import { siteSettings } from "@/data/site";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	pageType?: "website" | "article";
	publishedDate?: Date;
}

const {
	title = `${siteSettings.brandName} — ${siteSettings.tagline}`,
	description = siteSettings.description,
	image,
	pageType = "website",
	publishedDate,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.url.origin);
const ogImage = image ? new URL(image, Astro.url.origin).href : undefined;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="UTF-8" />
		<Font cssVariable="--font-sans" preload />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#111111" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content={pageType} />
		<meta property="og:site_name" content={siteSettings.brandName} />
		<meta property="og:locale" content="tr_TR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		{pageType === "article" && publishedDate && (
			<meta property="article:published_time" content={publishedDate.toISOString()} />
		)}

		<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
	</head>
	<body class="font-sans">
		<SiteHeader />
		<slot />
		<SiteFooter />
		<FloatingCta />
		<WuppycmsBridge />

		<script is:inline>
			(function () {
				const header = document.getElementById("site-header");
				if (header) {
					let sticky = false;
					const onScroll = () => {
						const next = window.scrollY > 40;
						if (next === sticky) return;
						sticky = next;
						header.setAttribute("data-sticky", String(sticky));
						header.classList.toggle("is-sticky", sticky);
					};
					window.addEventListener("scroll", onScroll, { passive: true });
					onScroll();
				}

				const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (reduceMotion) return;

				let observer;
				const initReveal = () => {
					if (observer) observer.disconnect();
					const items = document.querySelectorAll("[data-reveal]");
					if (!items.length) return;
					observer = new IntersectionObserver(
						(entries, obs) => {
							entries.forEach((entry) => {
								if (!entry.isIntersecting) return;
								const el = entry.target;
								el.style.opacity = "1";
								el.style.transform = "translateY(0)";
								obs.unobserve(el);
							});
						},
						{ rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
					);
					items.forEach((el) => {
						el.style.opacity = "0";
						el.style.transform = "translateY(1.25rem)";
						el.style.transition =
							"opacity .65s cubic-bezier(.22,1,.36,1), transform .65s cubic-bezier(.22,1,.36,1)";
						observer.observe(el);
					});
				};

				initReveal();
				document.addEventListener("astro:page-load", initReveal);
			})();
		</script>
	</body>
</html>
