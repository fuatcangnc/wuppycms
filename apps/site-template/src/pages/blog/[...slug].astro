---
import { ArrowRight, CalendarDays, Clock, Mail, User } from "@lucide/astro";
import { getCollection, getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import InternalHero from "@/components/InternalHero.astro";
import { siteSettings } from "@/data/site";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = await getEntry("authors", post.data.author);

const formatDate = (date: Date) =>
	date.toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" });
const body = post.body ?? "";
const readTime = `${Math.max(1, Math.ceil(body.split(/\s+/).length / 200))} dk`;
const tag = post.data.tags[0] || "İçerik";

const related = (await getCollection("blog", ({ data }) => !data.draft))
	.filter((entry) => entry.id !== post.id)
	.sort((a, b) => {
		const aScore = a.data.tags.filter((t) => post.data.tags.includes(t)).length;
		const bScore = b.data.tags.filter((t) => post.data.tags.includes(t)).length;
		return bScore - aScore || b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	})
	.slice(0, 3);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.pubDate.toISOString(),
	author: { "@type": "Person", name: author?.data.name || post.data.author },
	publisher: { "@type": "Organization", name: siteSettings.brandName },
};
---

<Base
	title={`${post.data.title} | ${siteSettings.brandName}`}
	description={post.data.description}
	pageType="article"
	publishedDate={post.data.pubDate}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<main>
		<InternalHero
			eyebrow={tag}
			title={post.data.title}
			description={post.data.description}
			breadcrumbTitle={post.data.title}
		/>

		<section class="post-page">
			<div class="shell post-layout">
				<article class="post-content" data-wuppycms-content={JSON.stringify({ collection: "blog", slug: post.id })}>
					<div class="mb-8 flex flex-wrap items-center gap-4 border-b border-neutral-200 pb-6 text-xs font-medium text-neutral-500">
						<span class="inline-flex items-center gap-1.5">
							<CalendarDays size={14} /> {formatDate(post.data.pubDate)}
						</span>
						<span class="inline-flex items-center gap-1.5">
							<Clock size={14} /> {readTime}
						</span>
						{
							author && (
								<span class="inline-flex items-center gap-1.5">
									<User size={14} /> {author.data.name} · {author.data.role}
								</span>
							)
						}
						<span class="bg-primary/10 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider text-primary">
							{tag}
						</span>
					</div>

					<div class="post-body">
						<Content />
					</div>
				</article>

				<aside class="detail-side space-y-5">
					<div class="side-card">
						<p class="text-[11px] font-black uppercase tracking-[0.16em] text-primary">WuppyCMS</p>
						<h2 class="mt-2">Reponuzu bağlayın.</h2>
						<p>
							İçeriğinizi GitHub'da tutun, AI ile düzenleyin, her değişikliği commit olarak
							saklayın.
						</p>
						<a
							href="/#iletisim"
							class="mt-4 inline-flex min-h-11 w-full items-center justify-center gap-2 bg-primary px-4 text-xs font-black uppercase tracking-wider text-white transition-colors hover:bg-[#b84d12]"
						>
							Demo talep et <ArrowRight size={14} />
						</a>
						<a
							href={`mailto:${siteSettings.email}`}
							class="mt-2 inline-flex min-h-11 w-full items-center justify-center gap-2 border border-neutral-300 bg-white px-4 text-xs font-black uppercase tracking-wider text-neutral-950 transition-colors hover:border-primary hover:text-primary"
						>
							<Mail size={14} /> E-posta
						</a>
					</div>

					{
						related.length > 0 && (
							<div class="border border-neutral-200 bg-white p-5">
								<h2 class="text-sm font-black uppercase tracking-tight text-neutral-950">İlgili yazılar</h2>
								<ul class="mt-4 space-y-3">
									{related.map((entry) => (
										<li class="border-b border-neutral-100 pb-3 last:border-b-0 last:pb-0">
											<a href={`/blog/${entry.id}`} class="group block">
												<span class="font-mono text-[10px] font-bold uppercase tracking-wider text-neutral-400">
													{formatDate(entry.data.pubDate)}
												</span>
												<span class="mt-1 block text-xs font-bold leading-snug text-neutral-900 transition-colors group-hover:text-primary">
													{entry.data.title}
												</span>
											</a>
										</li>
									))}
								</ul>
								<a href="/blog" class="mt-4 inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-wider text-primary hover:text-neutral-950">
									Tüm yazılar <ArrowRight size={13} />
								</a>
							</div>
						)
					}

					<div class="border border-neutral-200 bg-neutral-50 p-5">
						<p class="text-[11px] font-black uppercase tracking-[0.16em] text-primary">Etiketler</p>
						<div class="mt-3 flex flex-wrap gap-1.5">
							{post.data.tags.map((t) => (
								<a href={`/blog#${encodeURIComponent(t)}`} class="border border-neutral-200 bg-white px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-neutral-600 transition-colors hover:border-primary hover:text-primary">
									{t}
								</a>
							))}
						</div>
					</div>
				</aside>
			</div>
		</section>
	</main>
</Base>

<style>
	.post-body :global(h2) {
		margin: 2.2rem 0 0.8rem;
		border-left: 4px solid var(--primary);
		background: #fafafa;
		padding: 0.7rem 1rem;
		color: #1a1a1a;
		font-size: 1.4rem;
		font-weight: 900;
		letter-spacing: -0.04em;
	}
	.post-body :global(h2:first-child) {
		margin-top: 0;
	}
	.post-body :global(h3) {
		margin: 1.8rem 0 0.6rem;
		color: var(--navy-soft);
		font-size: 1.05rem;
		font-weight: 900;
	}
	.post-body :global(p),
	.post-body :global(li) {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.9;
	}
	.post-body :global(p) {
		margin: 1rem 0;
	}
	.post-body :global(ul),
	.post-body :global(ol) {
		display: grid;
		gap: 0.55rem;
		margin: 1rem 0;
		padding-left: 1.3rem;
	}
	.post-body :global(ul) {
		list-style: disc;
	}
	.post-body :global(ol) {
		list-style: decimal;
	}
	.post-body :global(li) {
		padding-left: 0.15rem;
	}
	.post-body :global(li::marker) {
		color: var(--primary);
		font-weight: 900;
	}
	.post-body :global(a) {
		color: var(--primary);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.post-body :global(blockquote) {
		margin: 2rem 0;
		border-top: 3px solid var(--primary);
		background: var(--navy);
		padding: 1.3rem 1.6rem;
		color: #fff;
	}
	.post-body :global(blockquote p) {
		color: #fff;
	}
	.post-body :global(code) {
		border: 1px solid #e5e5e5;
		background: #fafafa;
		padding: 0.1rem 0.3rem;
		font-family: var(--font-mono), monospace;
		font-size: 0.82em;
		color: #111;
	}
	.post-body :global(pre) {
		overflow-x: auto;
		border-left: 4px solid var(--primary);
		background: #0b0e11;
		padding: 1rem 1.2rem;
		color: #fff;
	}
	.post-body :global(pre code) {
		border: 0;
		background: transparent;
		padding: 0;
		color: inherit;
	}
	.post-body :global(img) {
		width: 100%;
		border: 1px solid #e5e5e5;
	}
	.post-body :global(hr) {
		margin: 2rem 0;
		border-color: #e5e5e5;
	}
</style>
