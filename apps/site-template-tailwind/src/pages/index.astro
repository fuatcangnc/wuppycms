---
import Base from "../layouts/Base.astro";
import { highlights, siteSettings, work } from "../data/site";
---

<Base title={`${siteSettings.brandName} — ${siteSettings.tagline}`}>
	<section class="max-w-3xl">
		<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">Hello, we are {siteSettings.brandName}</p>
		<h1 class="mt-4 text-5xl font-black tracking-[-0.06em] text-foreground sm:text-7xl">
			{siteSettings.tagline}
		</h1>
		<p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">{siteSettings.description}</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a class="inline-flex min-h-12 items-center bg-primary px-6 text-xs font-black uppercase tracking-wider text-white hover:bg-primary-dark" href="#contact">Get in touch</a>
			<a class="inline-flex min-h-12 items-center border border-border px-6 text-xs font-black uppercase tracking-wider text-foreground hover:border-primary hover:text-primary" href="#about">Learn more</a>
		</div>
	</section>

	<section id="about" class="mt-24 border-t border-border pt-12">
		<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">About</p>
		<h2 class="mt-3 text-3xl font-black tracking-tight text-foreground">A simple site with a strong point of view.</h2>
		<div class="mt-8 grid gap-4 sm:grid-cols-3">
			{
				highlights.map((item) => (
					<div class="border border-border bg-muted/40 p-5">
						<h3 class="font-bold text-foreground">{item.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section id="work" class="mt-24 border-t border-border pt-12">
		<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">Work</p>
		<h2 class="mt-3 text-3xl font-black tracking-tight text-foreground">What we can build together.</h2>
		<div class="mt-8 grid gap-4 sm:grid-cols-3">
			{
				work.map((item, index) => (
					<div class="border border-border p-5">
						<span class="font-mono text-xs text-primary">{String(index + 1).padStart(2, "0")}</span>
						<h3 class="mt-4 font-bold text-foreground">{item.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section id="contact" class="mt-24 border-t border-border pt-12">
		<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">Contact</p>
		<h2 class="mt-3 text-3xl font-black tracking-tight text-foreground">Let’s make something clear.</h2>
		<a class="mt-6 inline-flex items-center text-lg font-bold text-primary hover:text-primary-dark" href={`mailto:${siteSettings.email}`}>
			{siteSettings.email}
		</a>
	</section>
</Base>
